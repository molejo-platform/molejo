MOLEJO_MODE=development
MOLEJO_PUBLIC_URL=http://127.0.0.1:8080
MOLEJO_ALLOWED_ORIGIN=http://127.0.0.1:8080
MOLEJO_ALLOWED_HOSTS=127.0.0.1:8080,control-plane-api,control-plane-api.molejo-control-plane.svc,control-plane-api.molejo-control-plane.svc.cluster.local,control-plane-api.molejo-control-plane.svc.cluster.local:8444
MOLEJO_ALLOWED_REGISTRIES=ghcr.io,registry.molejo.dev
MOLEJO_COOKIE_SECURE=false
MOLEJO_TOTP_ENABLED=false
MOLEJO_HTTP_ADDR=:8444
MOLEJO_HTTP_TLS_CERT_FILE=/var/run/secrets/molejo/agent-server/tls.crt
MOLEJO_HTTP_TLS_KEY_FILE=/var/run/secrets/molejo/agent-server/tls.key
MOLEJO_AGENT_CA_CERT_FILE=/var/run/secrets/molejo/agent-ca/ca.crt
MOLEJO_AGENT_CA_KEY_FILE=/var/run/secrets/molejo/agent-ca/ca.key
MOLEJO_AGENT_SERVER_CERT_FILE=/var/run/secrets/molejo/agent-server/tls.crt
MOLEJO_AGENT_SERVER_KEY_FILE=/var/run/secrets/molejo/agent-server/tls.key
MOLEJO_AGENT_SERVER_CA_CERT_FILE=/var/run/secrets/molejo/server-ca/ca.crt
MOLEJO_AGENT_GRPC_ADDR=:8443
