MOLEJO_MODE=production
MOLEJO_PUBLIC_URL=https://cloud.molejo.dev
MOLEJO_PUBLIC_DOMAIN=molejo.dev
MOLEJO_PUBLIC_STATEFUL_DOMAIN=stateful.molejo.dev
MOLEJO_PUBLIC_TCP_ENABLED=true
MOLEJO_PUBLIC_TCP_ADDRESS=molejo.dev
MOLEJO_PUBLIC_TCP_MIN_PORT=20000
MOLEJO_PUBLIC_TCP_MAX_PORT=20015
MOLEJO_WORKSPACE_NAMESPACE=molejo-workspaces
MOLEJO_ALLOWED_ORIGIN=https://cloud.molejo.dev
MOLEJO_ALLOWED_HOSTS=cloud.molejo.dev
MOLEJO_ALLOWED_REGISTRIES=ghcr.io,required-external-build-registry
MOLEJO_TRUSTED_PROXY_CIDRS=required-external-proxy-cidr
MOLEJO_COOKIE_SECURE=true
MOLEJO_FIELD_MANAGER=molejo-control-plane
MOLEJO_OPENBAO_ADDR=https://openbao.molejo-secrets.svc:8200
MOLEJO_OPENBAO_KUBERNETES_AUTH_MOUNT=kubernetes
MOLEJO_OPENBAO_KV_MOUNT=parameters
MOLEJO_OPENBAO_ROLE=molejo-parameter-writer
MOLEJO_PARAMETER_RETENTION=168h
MOLEJO_PARAMETER_MUTATION_TIMEOUT=5m
MOLEJO_CLICKHOUSE_URL=http://clickhouse.molejo-observability.svc:8123
MOLEJO_CLICKHOUSE_DATABASE=otel
MOLEJO_CLICKHOUSE_USERNAME=molejo_reader
MOLEJO_CLICKHOUSE_PASSWORD_FILE=/var/run/secrets/molejo/observability/reader-password
MOLEJO_VICTORIAMETRICS_URL=http://victoria-metrics.molejo-observability.svc:8428
MOLEJO_OBSERVABILITY_LOG_MAX_WINDOW=24h
MOLEJO_OBSERVABILITY_METRIC_MAX_WINDOW=720h
MOLEJO_OBSERVABILITY_EVENT_MAX_WINDOW=168h
MOLEJO_OBSERVABILITY_LIVE_TTL=10m
MOLEJO_OBSERVABILITY_LIVE_POLL=2s
MOLEJO_OBSERVABILITY_LIVE_PER_USER=3
MOLEJO_OBSERVABILITY_METRICS_LIVE_POLL=30s
MOLEJO_OBSERVABILITY_METRICS_LIVE_PER_USER=2
MOLEJO_EXPECTED_CLUSTER_UID=required-external-cluster-uid
MOLEJO_STORAGE_PROFILE_ID=persistent-standard
MOLEJO_STORAGE_PROFILE_NAME=Persistent storage
MOLEJO_STORAGE_PROFILE_MIN_GIB=1
MOLEJO_STORAGE_PROFILE_MAX_GIB=10
MOLEJO_STORAGE_PROFILE_TOTAL_GIB=10
MOLEJO_STORAGE_PROFILE_WORKSPACE_QUOTA_GIB=10
MOLEJO_STORAGE_PROFILE_EXPANDABLE=true
MOLEJO_STORAGE_PROFILE_DURABILITY=NodeLocal
MOLEJO_STORAGE_PROFILE_RUNTIME_BINDING=molejo-app-local
