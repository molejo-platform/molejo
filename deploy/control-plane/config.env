FRUTO_MODE=production
FRUTO_PUBLIC_URL=https://cloud.molejo.dev
FRUTO_PUBLIC_DOMAIN=molejo.dev
FRUTO_PUBLIC_TCP_ENABLED=true
FRUTO_PUBLIC_TCP_ADDRESS=molejo.dev
FRUTO_PUBLIC_TCP_MIN_PORT=20000
FRUTO_PUBLIC_TCP_MAX_PORT=20015
FRUTO_WORKSPACE_NAMESPACE=fruto-workspaces
FRUTO_ALLOWED_ORIGIN=https://cloud.molejo.dev
FRUTO_ALLOWED_HOSTS=cloud.molejo.dev
FRUTO_ALLOWED_REGISTRIES=ghcr.io,required-external-build-registry
FRUTO_TRUSTED_PROXY_CIDRS=required-external-proxy-cidr
FRUTO_COOKIE_SECURE=true
FRUTO_FIELD_MANAGER=fruto-control-plane
FRUTO_OPENBAO_ADDR=https://openbao.molejo-secrets.svc:8200
FRUTO_OPENBAO_KUBERNETES_AUTH_MOUNT=kubernetes
FRUTO_OPENBAO_KV_MOUNT=parameters
FRUTO_OPENBAO_ROLE=molejo-parameter-writer
FRUTO_PARAMETER_RETENTION=168h
FRUTO_PARAMETER_MUTATION_TIMEOUT=5m
FRUTO_CLICKHOUSE_URL=http://clickhouse.molejo-observability.svc:8123
FRUTO_CLICKHOUSE_DATABASE=otel
FRUTO_CLICKHOUSE_USERNAME=molejo_reader
FRUTO_CLICKHOUSE_PASSWORD_FILE=/var/run/secrets/molejo/observability/reader-password
FRUTO_VICTORIAMETRICS_URL=http://victoria-metrics.molejo-observability.svc:8428
FRUTO_OBSERVABILITY_LOG_MAX_WINDOW=24h
FRUTO_OBSERVABILITY_METRIC_MAX_WINDOW=720h
FRUTO_OBSERVABILITY_EVENT_MAX_WINDOW=168h
FRUTO_OBSERVABILITY_LIVE_TTL=10m
FRUTO_OBSERVABILITY_LIVE_POLL=2s
FRUTO_OBSERVABILITY_LIVE_PER_USER=3
FRUTO_OBSERVABILITY_METRICS_LIVE_POLL=30s
FRUTO_OBSERVABILITY_METRICS_LIVE_PER_USER=2
FRUTO_EXPECTED_CLUSTER_UID=required-external-cluster-uid
FRUTO_STORAGE_PROFILE_ID=persistent-standard
FRUTO_STORAGE_PROFILE_NAME=Persistent storage
FRUTO_STORAGE_PROFILE_MIN_GIB=1
FRUTO_STORAGE_PROFILE_MAX_GIB=10
FRUTO_STORAGE_PROFILE_TOTAL_GIB=10
FRUTO_STORAGE_PROFILE_WORKSPACE_QUOTA_GIB=10
FRUTO_STORAGE_PROFILE_EXPANDABLE=true
FRUTO_STORAGE_PROFILE_DURABILITY=NodeLocal
FRUTO_STORAGE_PROFILE_RUNTIME_BINDING=molejo-app-local
